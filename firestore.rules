rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection (Pharmacy owners)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId);
    }

    // Pharmacies Collection
    // Public read so patients can search and view details
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || pharmacyId == request.auth.uid);
    }

    // Medicines Collection
    // Public read so patients can search and view availability
    match /medicines/{medicineId} {
      allow read: if true;
      // Creation: must be authenticated and owner of the pharmacy
      allow create: if isAuthenticated() && 
                    request.resource.data.pharmacyId != null &&
                    (request.resource.data.ownerId == request.auth.uid || request.resource.data.pharmacyId == request.auth.uid);
      // Update and delete: must be owner of the pharmacy associated with medicine
      allow update, delete: if isAuthenticated() && 
                            (resource.data.ownerId == request.auth.uid || resource.data.pharmacyId == request.auth.uid);
    }
  }
}
